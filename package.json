{
  "name": "cyfil-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:lan": "vite --mode dev --host",
    "build:prod": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "serve:test": "vite preview --mode test --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:prod-bundle": "node scripts/check-prod-bundle.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:prod && npm run build:dev && npm run build:test && npm run check:prod-bundle && npm run e2e",
    "check:fast": "npm run typecheck && npm run lint && npm run test && npm run build:prod && npm run build:dev && npm run check:prod-bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
